RomFS/
romfs/
ExeFS/
exefs/
[Rr]om[Ff][Ss]/
[Ee]xe[Ff][Ss]/
*.nsp
*.xci
*.nsz
*.xcz
*.nca
*.nso
*.nro
*.bin
*.patched.bin
prod.keys
title.keys
*.keys

# Shaders & Translation Caches
*.dmsv
*.spv
captured_shaders/
captured_shaders_device/
