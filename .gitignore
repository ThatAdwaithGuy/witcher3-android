# Toolchains, Local SDKs & Game Dumps
/tools/
/work/
/.gamedump/
/.venv/
env/
venv/

# Logs & Tomlstones
*.log
tombstone*
crash_*.txt
*.stackdump

# Media & Recordings
*.mp4
*.mov
*.webm
*.mkv
*.avi

# Python caches
